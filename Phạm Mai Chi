//pham mai chi
#include <iostream>
#include <iomanip>
#include <string>

using namespace std;

class phong {
private:
    string ma, loai;
    int tang, succhua;
    float gia;
    int trangthai; // 1: con trong, 0: da thue

public:
    void nhap() {
        cout << "  - Nhap ma phong: "; cin >> ma;
        cout << "  - Nhap loai phong: "; cin >> loai;
        cout << "  - Nhap tang: "; cin >> tang;
        cout << "  - Nhap suc chua: "; cin >> succhua;
        cout << "  - Nhap gia thue: "; cin >> gia;
        cout << "  - Nhap trang thai (1: con trong, 0: da thue): "; cin >> trangthai;
    }

    void xuat() const {
        cout << left << setw(10) << ma
             << setw(10) << loai
             << setw(10) << tang
             << setw(12) << succhua
             << setw(12) << gia
             << (trangthai == 1 ? "con trong" : "da thue") << endl;
    }
};

phong a[200];

void xoaPhong(phong a[], int &n, int k) {
    if (k < 0 || k >= n) {
        cout << "Vi tri k = " << k << " khong hop le de xoa!\n";
        return;
    }
    for (int i = k; i < n - 1; i++) {
        a[i] = a[i + 1];
    }
    n--; 
    cout << "-> Da xoa thanh cong phong tai vi tri " << k << endl;
}

void boSungPhong(phong a[], int &n, int k) {
    if (k < 0 || k > n || n >= 200) {
        cout << "Vi tri k = " << k << " khong hop le hoac danh sach da day!\n";
        return;
    }
    phong x;
    cout << "\n--- Nhap thong tin phong can bo sung ---\n";
    x.nhap();

    for (int i = n; i > k; i--) {
        a[i] = a[i - 1];
    }
    a[k] = x; 
    n++;     
    cout << "-> Da bo sung thanh cong phong vao vi tri " << k << endl;
}

void xuatDanhSach(phong a[], int n) {
    cout << "\n---------------- DANH SACH PHONG ----------------\n";
    cout << left << setw(10) << "ma"
         << setw(10) << "loai"
         << setw(10) << "tang"
         << setw(12) << "suc chua"
         << setw(12) << "gia"
         << "trang thai" << endl;
    for (int i = 0; i < n; i++) {
        a[i].xuat();
    }
}

int main() {
    int n;
    do {
        cout << "nhap so luong phong: ";
        cin >> n;
    } while (n <= 0 || n >= 200);

    cout << "\nnhap danh sach phong:\n";
    for (int i = 0; i < n; i++) {
        cout << "\nnhap phong thu " << i + 1 << ":\n";
        a[i].nhap();
    }

    xuatDanhSach(a, n);

    int kXoa, kChen;

    cout << "\nNhap vi tri k can XOA (0 den " << n - 1 << "): ";
    cin >> kXoa;
    xoaPhong(a, n, kXoa);
    xuatDanhSach(a, n);

    cout << "\nNhap vi tri k can BO SUNG (0 den " << n << "): ";
    cin >> kChen;
    boSungPhong(a, n, kChen);
    xuatDanhSach(a, n);

    return 0;
}
